<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Explore Local Businesses | Boostly</title>

<meta name="description"
content="Discover local businesses, services, offers and trusted businesses with Boostly.">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f7f8fc;
    color:#101828;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

button,
input,
select{
    font:inherit;
}

/* ================= HEADER ================= */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(12px);
    border-bottom:1px solid #e8eaf0;
}

.navbar{
    max-width:1200px;
    margin:auto;
    height:78px;
    padding:0 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:32px;
    font-weight:800;
    letter-spacing:-1.5px;
}

.logo span{
    color:#635bff;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:28px;
}

.nav-links a{
    font-size:15px;
    font-weight:600;
    color:#475467;
    transition:.25s;
}

.nav-links a:hover,
.nav-links a.active{
    color:#635bff;
}

.nav-buttons{
    display:flex;
    align-items:center;
    gap:10px;
}

.login-btn{
    padding:11px 18px;
    border-radius:10px;
    font-weight:700;
    color:#475467;
}

.signup-btn{
    padding:12px 19px;
    border-radius:11px;
    background:#635bff;
    color:white;
    font-weight:700;
    box-shadow:0 8px 20px rgba(99,91,255,.20);
}

.menu-btn{
    display:none;
    border:0;
    background:#f1f2f6;
    width:44px;
    height:44px;
    border-radius:10px;
    font-size:25px;
    cursor:pointer;
}

/* MOBILE MENU */

.mobile-menu{
    display:none;
    background:white;
    border-top:1px solid #eee;
    padding:15px 24px 22px;
}

.mobile-menu a{
    display:block;
    padding:14px 0;
    font-weight:700;
    color:#344054;
    border-bottom:1px solid #f0f1f5;
}

/* ================= HERO ================= */

.hero{
    background:
    radial-gradient(circle at 10% 20%,rgba(99,91,255,.14),transparent 30%),
    radial-gradient(circle at 90% 30%,rgba(45,212,191,.12),transparent 28%),
    #f8f9ff;
    padding:80px 20px 60px;
    text-align:center;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 17px;
    border-radius:50px;
    background:#eceaff;
    color:#5148d9;
    font-weight:700;
    margin-bottom:22px;
    animation:fadeUp .7s ease both;
}

.hero h1{
    max-width:850px;
    margin:auto;
    font-size:clamp(42px,7vw,76px);
    line-height:1.02;
    letter-spacing:-3px;
    animation:fadeUp .8s ease both;
}

.hero h1 span{
    color:#635bff;
}

.hero p{
    max-width:650px;
    margin:25px auto 0;
    color:#667085;
    font-size:19px;
    line-height:1.7;
    animation:fadeUp .9s ease both;
}

/* ================= SEARCH ================= */

.search-area{
    max-width:1050px;
    margin:-15px auto 0;
    padding:0 20px;
    position:relative;
    z-index:10;
}

.search-box{
    background:white;
    border:1px solid #e4e7ec;
    border-radius:22px;
    padding:18px;
    box-shadow:0 18px 50px rgba(16,24,40,.10);
    display:grid;
    grid-template-columns:1.6fr 1fr 1fr auto;
    gap:12px;
}

.input-wrap{
    position:relative;
}

.input-wrap span{
    position:absolute;
    left:15px;
    top:50%;
    transform:translateY(-50%);
    font-size:19px;
}

.search-box input,
.search-box select{
    width:100%;
    height:52px;
    border:1px solid #d9dde5;
    border-radius:12px;
    padding:0 14px 0 44px;
    outline:none;
    background:white;
    color:#344054;
}

.search-box select{
    padding-left:15px;
}

.search-box input:focus,
.search-box select:focus{
    border-color:#635bff;
    box-shadow:0 0 0 3px rgba(99,91,255,.10);
}

.search-btn{
    height:52px;
    border:0;
    border-radius:12px;
    background:#635bff;
    color:white;
    padding:0 24px;
    font-weight:800;
    cursor:pointer;
    transition:.25s;
}

.search-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 25px rgba(99,91,255,.25);
}

/* ================= CATEGORIES ================= */

.categories{
    max-width:1200px;
    margin:60px auto 0;
    padding:0 20px;
}

.section-heading{
    display:flex;
    align-items:end;
    justify-content:space-between;
    margin-bottom:25px;
}

.section-heading h2{
    font-size:32px;
    letter-spacing:-1px;
}

.section-heading p{
    color:#667085;
    margin-top:6px;
}

.category-grid{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:14px;
}

.category{
    background:white;
    border:1px solid #e4e7ec;
    border-radius:17px;
    padding:22px 12px;
    text-align:center;
    cursor:pointer;
    transition:.3s;
}

.category:hover,
.category.selected{
    transform:translateY(-5px);
    border-color:#635bff;
    box-shadow:0 12px 28px rgba(99,91,255,.12);
}

.category-icon{
    width:54px;
    height:54px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 10px;
    border-radius:15px;
    background:#eeecff;
    font-size:26px;
}

.category strong{
    font-size:14px;
}

/* ================= RESULTS ================= */

.results{
    max-width:1200px;
    margin:65px auto;
    padding:0 20px;
}

.results-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.results-top h2{
    font-size:32px;
    letter-spacing:-1px;
}

#resultCount{
    color:#667085;
    margin-top:5px;
}

.reset-btn{
    border:1px solid #d0d5dd;
    background:white;
    padding:10px 16px;
    border-radius:10px;
    cursor:pointer;
    font-weight:700;
    color:#344054;
}

.reset-btn:hover{
    border-color:#635bff;
    color:#635bff;
}

/* ================= BUSINESS CARDS ================= */

.business-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.business-card{
    background:white;
    border:1px solid #e4e7ec;
    border-radius:20px;
    overflow:hidden;
    transition:.35s;
    animation:fadeUp .7s ease both;
}

.business-card:hover{
    transform:translateY(-7px);
    box-shadow:0 20px 45px rgba(16,24,40,.10);
}

.business-image{
    height:215px;
    position:relative;
    overflow:hidden;
}

.business-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.business-card:hover .business-image img{
    transform:scale(1.06);
}

.verified{
    position:absolute;
    left:14px;
    top:14px;
    background:white;
    color:#087443;
    padding:7px 11px;
    border-radius:50px;
    font-size:12px;
    font-weight:800;
    box-shadow:0 4px 15px rgba(0,0,0,.10);
}

.rating{
    position:absolute;
    right:14px;
    top:14px;
    background:white;
    padding:7px 10px;
    border-radius:50px;
    font-weight:800;
    color:#b54708;
    box-shadow:0 4px 15px rgba(0,0,0,.10);
}

.business-content{
    padding:20px;
}

.business-content h3{
    font-size:21px;
    margin-bottom:8px;
}

.location{
    color:#667085;
    font-size:14px;
    margin-bottom:14px;
}

.description{
    color:#667085;
    font-size:14px;
    line-height:1.6;
    min-height:45px;
}

.tags{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
    margin:16px 0;
}

.tag{
    background:#f2f4f7;
    color:#475467;
    padding:6px 9px;
    border-radius:7px;
    font-size:12px;
    font-weight:700;
}

.card-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
}

.card-actions a{
    text-align:center;
    padding:11px 8px;
    border-radius:10px;
    font-size:13px;
    font-weight:800;
}

.call-btn{
    background:#635bff;
    color:white;
}

.whatsapp-btn{
    background:#e8f8ef;
    color:#087443;
}

.no-results{
    display:none;
    text-align:center;
    background:white;
    border:1px solid #e4e7ec;
    border-radius:18px;
    padding:55px 20px;
}

.no-results div{
    font-size:45px;
    margin-bottom:10px;
}

/* ================= CTA ================= */

.cta-section{
    padding:30px 20px 90px;
}

.cta{
    max-width:1150px;
    margin:auto;
    border-radius:30px;
    padding:70px 30px;
    text-align:center;
    background:linear-gradient(135deg,#635bff,#7c3aed);
    color:white;
    box-shadow:0 25px 60px rgba(99,91,255,.20);
}

.cta h2{
    font-size:clamp(35px,5vw,55px);
    letter-spacing:-2px;
}

.cta p{
    max-width:600px;
    margin:18px auto 28px;
    font-size:18px;
    line-height:1.6;
    color:#eeecff;
}

.cta a{
    display:inline-block;
    background:white;
    color:#5148d9;
    padding:14px 25px;
    border-radius:12px;
    font-weight:800;
    transition:.25s;
}

.cta a:hover{
    transform:translateY(-3px);
}

/* ================= FOOTER ================= */

footer{
    background:#101828;
    color:white;
    padding:55px 20px 25px;
}

.footer-inner{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:40px;
}

.footer-brand h2{
    font-size:29px;
    margin-bottom:12px;
}

.footer-brand h2 span{
    color:#8178ff;
}

.footer-brand p{
    max-width:330px;
    color:#98a2b3;
    line-height:1.6;
}

footer h4{
    margin-bottom:15px;
}

footer ul{
    list-style:none;
}

footer li{
    margin:11px 0;
    color:#98a2b3;
}

footer li a:hover{
    color:white;
}

.copyright{
    max-width:1200px;
    margin:40px auto 0;
    padding-top:22px;
    border-top:1px solid #263143;
    color:#98a2b3;
    font-size:14px;
}

/* ================= ANIMATIONS ================= */

@keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(25px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* ================= TABLET ================= */

@media(max-width:900px){

    .nav-links,
    .nav-buttons{
        display:none;
    }

    .menu-btn{
        display:block;
    }

    .search-box{
        grid-template-columns:1fr 1fr;
    }

    .search-btn{
        width:100%;
    }

    .category-grid{
        grid-template-columns:repeat(3,1fr);
    }

    .business-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .footer-inner{
        grid-template-columns:1fr 1fr;
    }
}

/* ================= MOBILE ================= */

@media(max-width:600px){

    .navbar{
        height:68px;
        padding:0 18px;
    }

    .logo{
        font-size:28px;
    }

    .hero{
        padding:55px 18px 55px;
    }

    .hero h1{
        font-size:44px;
        letter-spacing:-2px;
    }

    .hero p{
        font-size:16px;
    }

    .search-area{
        padding:0 14px;
    }

    .search-box{
        grid-template-columns:1fr;
        padding:14px;
        border-radius:18px;
    }

    .categories,
    .results{
        padding:0 15px;
    }

    .section-heading{
        display:block;
    }

    .section-heading h2,
    .results-top h2{
        font-size:27px;
    }

    .category-grid{
        grid-template-columns:repeat(2,1fr);
        gap:10px;
    }

    .category{
        padding:18px 8px;
    }

    .results{
        margin-top:50px;
    }

    .results-top{
        align-items:flex-start;
        gap:12px;
    }

    .business-grid{
        grid-template-columns:1fr;
    }

    .business-image{
        height:225px;
    }

    .cta{
        padding:55px 20px;
        border-radius:24px;
    }

    .cta p{
        font-size:16px;
    }

    .footer-inner{
        grid-template-columns:1fr;
        gap:28px;
    }

    .copyright{
        margin-top:30px;
    }
}
</style>
</head>

