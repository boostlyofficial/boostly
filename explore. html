<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Explore Businesses – Boostly</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f7f8fc;
  color:#171827;
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}

button,input,select{
  font:inherit;
}

/* NAVBAR */

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,255,255,.96);
  border-bottom:1px solid #e9e9ef;
  backdrop-filter:blur(10px);
}

.navbar{
  max-width:1180px;
  margin:auto;
  min-height:72px;
  padding:0 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:27px;
  font-weight:900;
  color:#5b50e6;
}

.nav-links{
  display:flex;
  gap:26px;
  align-items:center;
}

.nav-links a{
  font-size:14px;
  font-weight:700;
}

.nav-links a:hover{
  color:#5b50e6;
}

.menu-btn{
  display:none;
  border:0;
  background:none;
  font-size:28px;
  cursor:pointer;
}

.mobile-menu{
  display:none;
  background:white;
  border-top:1px solid #eee;
  padding:15px 20px;
}

.mobile-menu a{
  display:block;
  padding:12px 0;
  font-weight:700;
}

/* HERO */

.hero{
  background:linear-gradient(135deg,#5b50e6,#756cf0);
  color:white;
  padding:75px 20px 95px;
  text-align:center;
}

.hero-badge{
  display:inline-block;
  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.3);
  padding:8px 14px;
  border-radius:30px;
  font-size:13px;
  font-weight:700;
  margin-bottom:18px;
}

.hero h1{
  font-size:48px;
  line-height:1.1;
  margin-bottom:16px;
}

.hero p{
  max-width:650px;
  margin:0 auto;
  opacity:.92;
}

/* SEARCH */

.search-box{
  max-width:1050px;
  margin:-45px auto 50px;
  position:relative;
  z-index:10;
  background:white;
  padding:20px;
  border-radius:18px;
  box-shadow:0 15px 40px rgba(20,20,50,.12);
}

.search-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr auto;
  gap:12px;
}

.search-grid input,
.search-grid select{
  width:100%;
  padding:14px;
  border:1px solid #dddfea;
  border-radius:10px;
  outline:none;
  font-size:14px;
  background:white;
}

.search-grid input:focus,
.search-grid select:focus{
  border-color:#5b50e6;
}

.btn{
  border:0;
  border-radius:10px;
  padding:14px 22px;
  background:#5b50e6;
  color:white;
  font-weight:800;
  cursor:pointer;
  transition:.25s;
}

.btn:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 20px rgba(91,80,230,.25);
}

/* CONTENT */

.container{
  max-width:1180px;
  margin:auto;
  padding:0 20px 70px;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
  margin-bottom:25px;
}

.section-head h2{
  font-size:28px;
}

.section-head p{
  color:#6d7080;
  font-size:14px;
}

/* BUSINESS GRID */

.business-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.card{
  background:white;
  border:1px solid #e8e8f0;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 8px 25px rgba(20,20,50,.06);
  transition:.3s;
}

.card:hover{
  transform:translateY(-6px);
  box-shadow:0 18px 35px rgba(20,20,50,.12);
}

.card-image{
  height:190px;
  background:linear-gradient(135deg,#e9e7ff,#f5f4ff);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:55px;
}

.card-body{
  padding:20px;
}

.tag{
  display:inline-block;
  background:#f0efff;
  color:#5b50e6;
  padding:5px 10px;
  border-radius:20px;
  font-size:12px;
  font-weight:800;
  margin-bottom:10px;
}

.card h3{
  font-size:20px;
  margin-bottom:7px;
}

.location{
  color:#707382;
  font-size:13px;
  margin-bottom:12px;
}

.rating{
  font-size:14px;
  font-weight:800;
  margin-bottom:15px;
}

.card-btn{
  display:block;
  text-align:center;
  background:#171827;
  color:white;
  padding:11px;
  border-radius:10px;
  font-size:13px;
  font-weight:800;
  transition:.25s;
}

.card-btn:hover{
  background:#5b50e6;
}

/* EMPTY RESULT */

.no-results{
  display:none;
  text-align:center;
  background:white;
  border:1px solid #e8e8f0;
  padding:35px 20px;
  border-radius:16px;
  color:#707382;
}

/* CTA */

.cta{
  margin-top:70px;
  background:#171827;
  color:white;
  border-radius:24px;
  padding:50px 25px;
  text-align:center;
}

.cta h2{
  font-size:32px;
  margin-bottom:10px;
}

.cta p{
  max-width:600px;
  margin:0 auto 22px;
  color:#c9cad4;
}

.cta .btn{
  background:white;
  color:#171827;
}

/* FOOTER */

footer{
  background:white;
  border-top:1px solid #e8e8ef;
  padding:30px 20px;
  text-align:center;
  color:#777987;
  font-size:13px;
}

/* ANIMATION */

.fade-up{
  animation:fadeUp .7s ease both;
}

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(18px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* MOBILE */

@media(max-width:800px){

  .nav-links{
    display:none;
  }

  .menu-btn{
    display:block;
  }

  .hero{
    padding:55px 18px 80px;
  }

  .hero h1{
    font-size:36px;
  }

  .hero p{
    font-size:14px;
  }

  .search-box{
    margin:-35px 15px 40px;
    padding:15px;
  }

  .search-grid{
    grid-template-columns:1fr;
  }

  .btn{
    width:100%;
  }

  .business-grid{
    grid-template-columns:1fr;
  }

  .section-head{
    display:block;
  }

  .section-head h2{
    margin-bottom:5px;
  }

  .cta{
    margin-top:45px;
    padding:40px 20px;
  }

  .cta h2{
    font-size:26px;
  }
}
</style>
</head>

<body>

<header>
  <div class="navbar">

    <a href="index.html" class="logo">Boostly</a>

    <nav class="nav-links">
      <a href="index.html">Home</a>
      <a href="explore.html">Explore</a>
      <a href="business.html">For Business</a>
    </nav>

    <button class="menu-btn" onclick="toggleMenu()" aria-label="Open menu">
      ☰
    </button>

  </div>

  <div class="mobile-menu" id="mobileMenu">
    <a href="index.html">Home</a>
    <a href="explore.html">Explore</a>
    <a href="business.html">For Business</a>
  </div>
</header>

<section class="hero fade-up">
  <div class="hero-badge">DISCOVER • CONNECT • GROW</div>

  <h1>Explore Local Businesses</h1>

  <p>
    Discover businesses, services and local brands with Boostly.
    Search, explore and connect with businesses in your area.
  </p>
</section>

<div class="search-box fade-up">

  <div class="search-grid">

    <input
      type="text"
      id="searchInput"
      placeholder="Search business..."
      onkeyup="filterBusinesses()"
    >

    <select id="categoryFilter" onchange="filterBusinesses()">
      <option value="all">All Categories</option>
      <option value="restaurant">Restaurants</option>
      <option value="salon">Salon & Beauty</option>
      <option value="fitness">Fitness</option>
      <option value="retail">Retail</option>
    </select>

    <select id="locationFilter" onchange="filterBusinesses()">
      <option value="all">All Locations</option>
      <option value="local">Local</option>
      <option value="online">Online</option>
    </select>

    <button class="btn" onclick="filterBusinesses()">Search</button>

  </div>

</div>

<main class="container">

  <div class="section-head">
    <div>
      <h2>Featured Businesses</h2>
      <p>Explore businesses listed on Boostly.</p>
    </div>
  </div>

  <div class="business-grid" id="businessGrid">

    <article class="card business-card fade-up"
      data-name="Urban Bites"
      data-category="restaurant"
      data-location="local">

      <div class="card-image">🍽️</div>

      <div class="card-body">
        <span class="tag">Restaurant</span>
        <h3>Urban Bites</h3>
        <div class="location">📍 Local Business</div>
        <div class="rating">⭐ 4.8 • Popular</div>

        <a href="#" class="card-btn"
          onclick="showMessage('Urban Bites')">
          View Business
        </a>
      </div>

    </article>

    <article class="card business-card fade-up"
      data-name="Glow Studio"
      data-category="salon"
      data-location="local">

      <div class="card-image">💇</div>

      <div class="card-body">
        <span class="tag">Salon & Beauty</span>
        <h3>Glow Studio</h3>
        <div class="location">📍 Local Business</div>
        <div class="rating">⭐ 4.9 • Featured</div>

        <a href="#" class="card-btn"
          onclick="showMessage('Glow Studio')">
          View Business
        </a>
      </div>

    </article>

    <article class="card business-card fade-up"
      data-name="FitZone"
      data-category="fitness"
      data-location="local">

      <div class="card-image">🏋️</div>

      <div class="card-body">
        <span class="tag">Fitness</span>
        <h3>FitZone</h3>
        <div class="location">📍 Local Business</div>
        <div class="rating">⭐ 4.7 • Trending</div>

        <a href="#" class="card-btn"
          onclick="showMessage('FitZone')">
          View Business
        </a>
      </div>

    </article>

    <article class="card business-card fade-up"
      data-name="Style Market"
      data-category="retail"
      data-location="online">

      <div class="card-image">🛍️</div>

      <div class="card-body">
        <span class="tag">Retail</span>
        <h3>Style Market</h3>
        <div class="location">🌐 Online Business</div>
        <div class="rating">⭐ 4.6 • Featured</div>

        <a href="#" class="card-btn"
          onclick="showMessage('Style Market')">
          View Business
        </a>
      </div>

    </article>

    <article class="card business-card fade-up"
      data-name="Coffee Corner"
      data-category="restaurant"
      data-location="local">

      <div class="card-image">☕</div>

      <div class="card-body">
        <span class="tag">Restaurant</span>
        <h3>Coffee Corner</h3>
        <div class="location">📍 Local Business</div>
        <div class="rating">⭐ 4.8 • Popular</div>

        <a href="#" class="card-btn"
          onclick="showMessage('Coffee Corner')">
          View Business
        </a>
      </div>

    </article>

    <article class="card business-card fade-up"
      data-name="Power Gym"
      data-category="fitness"
      data-location="online">

      <div class="card-image">💪</div>

      <div class="card-body">
        <span class="tag">Fitness</span>
        <h3>Power Gym</h3>
        <div class="location">🌐 Online Business</div>
        <div class="rating">⭐ 4.7 • Featured</div>

        <a href="#" class="card-btn"
          onclick="showMessage('Power Gym')">
          View Business
        </a>
      </div>

    </article>

  </div>

  <div class="no-results" id="noResults">
    <h3>No businesses found</h3>
    <p>Try another business name, category or location.</p>
  </div>

  <section class="cta">

    <h2>Are you a business owner?</h2>

    <p>
      Put your business in front of more customers with Boostly.
    </p>

    <a href="business.html" class="btn">
      Grow My Business
    </a>

  </section>

</main>

<footer>
  © 2026 Boostly. Discover. Connect. Grow.
</footer>

<script>

function toggleMenu(){

  const menu = document.getElementById("mobileMenu");

  if(menu.style.display === "block"){
    menu.style.display = "none";
  }else{
    menu.style.display = "block";
  }

}

function filterBusinesses(){

  const search =
    document.getElementById("searchInput").value.toLowerCase();

  const category =
    document.getElementById("categoryFilter").value;

  const location =
    document.getElementById("locationFilter").value;

  const cards =
    document.querySelectorAll(".business-card");

  let visible = 0;

  cards.forEach(function(card){

    const name =
      card.getAttribute("data-name").toLowerCase();

    const cardCategory =
      card.getAttribute("data-category");

    const cardLocation =
      card.getAttribute("data-location");

    const matchesSearch =
      name.includes(search);

    const matchesCategory =
      category === "all" || cardCategory === category;

    const matchesLocation =
      location === "all" || cardLocation === location;

    if(
      matchesSearch &&
      matchesCategory &&
      matchesLocation
    ){

      card.style.display = "block";
      visible++;

    }else{

      card.style.display = "none";

    }

  });

  document.getElementById("noResults").style.display =
    visible === 0 ? "block" : "none";

}

function showMessage(name){

  event.preventDefault();

  alert(
    name +
    " business profile will be available soon on Boostly."
  );

}

</script>

</body>
</html>
