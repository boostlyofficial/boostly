<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Explore Businesses – Boostly</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f7f8fc;
  color:#171827;
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,255,255,.96);
  border-bottom:1px solid #e9e9ef;
  backdrop-filter:blur(10px);
}

.navbar{
  max-width:1180px;
  margin:auto;
  min-height:72px;
  padding:0 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:27px;
  font-weight:900;
  color:#5b50e6;
}

.nav-links{
  display:flex;
  gap:26px;
  align-items:center;
}

.nav-links a{
  font-size:14px;
  font-weight:700;
}

.nav-links a:hover{
  color:#5b50e6;
}

.menu-btn{
  display:none;
  border:0;
  background:none;
  font-size:28px;
  cursor:pointer;
}

.mobile-menu{
  display:none;
  background:white;
  border-top:1px solid #eee;
  padding:15px 20px;
}

.mobile-menu a{
  display:block;
  padding:12px 0;
  font-weight:700;
}

/* HERO */

.hero{
  background:linear-gradient(135deg,#5b50e6,#756cf0);
  color:white;
  padding:75px 20px;
  text-align:center;
}

.hero-badge{
  display:inline-block;
  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.3);
  padding:8px 14px;
  border-radius:30px;
  font-size:13px;
  font-weight:700;
  margin-bottom:18px;
}

.hero h1{
  font-size:48px;
  line-height:1.1;
  margin-bottom:16px;
}

.hero p{
  max-width:650px;
  margin:0 auto 30px;
  opacity:.92;
}

/* SEARCH */

.search-box{
  max-width:1000px;
  margin:-35px auto 45px;
  position:relative;
  z-index:10;
  background:white;
  padding:20px;
  border-radius:18px;
  box-shadow:0 15px 40px rgba(20,20,50,.12);
}

.search-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr auto;
  gap:12px;
}

.search-grid input,
.search-grid select{
  width:100%;
  padding:14px;
  border:1px solid #dddfea;
  border-radius:10px;
  outline:none;
  font-size:14px;
  background:white;
}

.search-grid input:focus,
.search-grid select:focus{
  border-color:#5b50e6;
}

